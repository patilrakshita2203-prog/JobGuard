# Streamlit Community Cloud: paste these into  App settings -> Secrets.
# (This file is only an example. The real secrets.toml is git-ignored.)

GEMINI_API_KEY = "your_gemini_api_key_here"

# Optional: point the hosted dashboard at your deployed FastAPI service
# JOBGUARD_API_URL = "https://jobguard-api.onrender.com"
# JOBGUARD_API_KEY = "same_key_you_set_on_the_api"

# Hosted servers have no Chrome, so switch the live scanner off
JOBGUARD_ENABLE_SCRAPING = "false"
