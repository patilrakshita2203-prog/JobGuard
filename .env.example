# Copy to .env and fill in. NEVER commit the real .env file.

# --- AI risk analysis (optional: the app falls back to rule-based summaries without it) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Dashboard -> API connection ---
JOBGUARD_API_URL=http://127.0.0.1:8000
# auto = use the API when reachable, else run the model inside the dashboard
# api  = require the API      local = never call the API
JOBGUARD_MODE=auto
# If you set a key on the API, the dashboard sends the same key automatically
# JOBGUARD_API_KEY=choose_a_long_random_string

# --- API hardening ---
# Comma-separated browser origins allowed to call the API (use * only for testing)
JOBGUARD_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
JOBGUARD_RATE_LIMIT=60
JOBGUARD_BATCH_RATE_LIMIT=10
JOBGUARD_MAX_UPLOAD_MB=5
JOBGUARD_MAX_BATCH_ROWS=2000

# --- Features ---
# Live scanner needs Selenium + Chrome. Set to false on hosted deployments.
JOBGUARD_ENABLE_SCRAPING=true
